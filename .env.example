# Copy this file to .env and fill in real values before running
# `docker-compose up -d --build`. Real secrets are not stored in this repo
# (.env is gitignored).
#
# IMPORTANT: several of the same underlying value are required under
# *different* variable names, because each component (the .NET bot, the PHP
# webui, the MySQL-compatible database image) was written to read its own
# naming convention. Keep every group below in sync manually -- there is no
# single source of truth, this is just how the existing code reads config.
#
# This stack expects to run behind an external nginx-proxy + acme-companion
# reverse proxy (same setup as this org's taiga-board deployment) that owns
# TLS termination and routes by VIRTUAL_HOST. It does not publish ports
# 80/443 to the host itself. Before `docker compose up`, make sure a Docker
# network named `nginx-proxy` already exists (created by that proxy stack).

# ---- Domain / reverse proxy ----
# Public hostname this bot's verify webui will be served at, and the email
# used for Let's Encrypt registration by the external proxy's acme-companion.
DOMAIN=verify.example.org
ADMIN_EMAIL=admin@example.org

# ---- Telegram bot ----
# From @botfather.
TGAPIKey=<telegram bot api token>

# The link sent to users to complete verification. Must contain %s (the bot
# substitutes the challenge id) and point at this deployment's public
# hostname. nginx serves the verify page at the site root, no path prefix.
APIEndpoint=https://verify.example.org/verify?actid=%s

# ---- Database credentials (shared value, different key names per consumer) ----
# Application database name -- used identically by both the `php` and
# `database` services (same key name, no duplication needed here).
MYSQL_DATABASE=xenfbot

# Application DB username/password -- same values, three different key names:
#   MYSQL_USER_USERNAME / MYSQL_USER_PASSWORD -> read by the PHP webui
#   MySQLUser / MySQLPassword                 -> read by the .NET bot
#   MYSQL_USER / MYSQL_PASSWORD               -> read by the percona/mysql
#                                                 image itself, to create the
#                                                 user and grant it access to
#                                                 MYSQL_DATABASE on first boot
MYSQL_USER_USERNAME=xenfbot
MYSQL_USER_PASSWORD=change-me
MySQLUser=xenfbot
MySQLPassword=change-me
MYSQL_USER=xenfbot
MYSQL_PASSWORD=change-me

# Hostname of the database service as seen by other containers -- this is
# the docker-compose service name, not localhost.
MYSQL_HOST=database
MySQLHost=database

# Table the PHP webui queries for verification records.
MYSQL_VERIFY_TABLE=verify

# ---- Database server (percona/percona-xtradb-cluster:5.7 image) ----
# Root password is required by the image or it refuses to start. CLUSTER_NAME
# is also required even for this single-node setup.
MYSQL_ROOT_PASSWORD=change-me
CLUSTER_NAME=xenbot
# Optional: password for the xtrabackup@localhost SST user the image creates.
# XTRABACKUP_PASSWORD=change-me

# ---- Database TLS client cert (optional) ----
# databank.php always calls mysqli::ssl_set() and connects with
# MYSQLI_CLIENT_SSL_DONT_VERIFY_SERVER_CERT. The database container's
# --ssl-* flags are commented out in docker-compose.yaml, so the stock
# image's auto-generated self-signed server cert is used and these can be
# left blank for a default setup. Only set them if you mount real client
# certs into ./certs and want mutual TLS to the database.
MYSQL_CA=
MYSQL_CLIENT_KEY=
MYSQL_CLIENT_CERT=

# ---- CAPTCHA ----
# nginx's default.conf routes `/` to verify/index.php, the hCaptcha variant,
# so XEN_HCAPTCHA_SITEKEY/SECRET are required for the default flow. The
# reCAPTCHA variant (index_recaptcha.php / verify_recaptcha.php) exists in
# frontend/src/verify/ but isn't wired up by the current nginx config --
# only fill in XEN_RECAPTCHA_* if you also change default.conf to route to it.
XEN_HCAPTCHA_SITEKEY=<hcaptcha site key>
XEN_HCAPTCHA_SECRET=<hcaptcha secret key>
# XEN_RECAPTCHA_SITEKEY=<recaptcha site key>
# XEN_RECAPTCHA_SECRET=<recaptcha secret key>
